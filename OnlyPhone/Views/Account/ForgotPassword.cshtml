@model OnlyPhone.Models.RegisterViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/Content/FontAwesome/css/all.min.css" rel="stylesheet" />
    <link href="~/Content/Css/Register.css" rel="stylesheet" />

    <style>
        /* Bổ sung CSS inline nếu file Register.css chưa có các class này */
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #00FFFF 100%);
        }

        /* Đảm bảo các step hiển thị đúng trạng thái */
        .form-section { display: none; animation: fadeIn 0.5s; }
        .form-section.active { display: block; }

        @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        /* Style cho nút Quay lại ở bước OTP */
        .btn-group { display: flex; gap: 10px; margin-top: 20px; }
        .btn-secondary { background: #e0e0e0; color: #333; }

        /* Alert styles */
        .alert { padding: 15px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; display: flex; align-items: center; gap: 10px; }
        .alert-danger { background: #ffebee; color: #c62828; border: 1px solid #ffcdd2; }
        .error-message {
        color: #dc3545; /* Màu đỏ */
        font-size: 0.875rem;
        margin-top: 5px;
        display: block;
        font-weight: 500;
    }

    /* THÊM MỚI: Style viền đỏ khi nhập sai */
    .input-error {
        border: 1px solid #dc3545 !important;
        background-color: #fff8f8;
    }

    /* Animation rung nhẹ khi lỗi (Optional) */
    @@keyframes shake {
        0% { transform: translateX(0); }
        25% { transform: translateX(-5px); }
        50% { transform: translateX(5px); }
        75% { transform: translateX(-5px); }
        100% { transform: translateX(0); }
    }
    .shake {
        animation: shake 0.3s ease-in-out;
    }
        .alert-success { background: #e8f5e9; color: #2e7d32; border: 1px solid #c8e6c9; }
        .alert-info { background: #e3f2fd; color: #1565c0; border: 1px solid #bbdefb; }
    </style>
</head>
<body>
    <div class="register-container">
        <div class="register-card">
            <div class="card-header">
                <a href="/Home" class="logo">
                    <span>OnlyPhone</span>
                </a>
                <h1>Khôi phục tài khoản</h1>
                <p>Đừng lo, chúng tôi sẽ giúp bạn lấy lại mật khẩu!</p>
            </div>

            <div class="card-body">
                <div class="step-indicator">
                    <div class="step active" id="indicator1">
                        <div class="step-circle">1</div>
                        <div class="step-label">Email</div>
                    </div>
                    <div class="step" id="indicator2">
                        <div class="step-circle">2</div>
                        <div class="step-label">OTP</div>
                    </div>
                    <div class="step" id="indicator3">
                        <div class="step-circle">3</div>
                        <div class="step-label">Mật khẩu mới</div>
                    </div>
                </div>

                <div id="alertContainer"></div>

                <form id="forgotPasswordForm">
                    @Html.AntiForgeryToken()

                    <div class="form-section active" id="step1">
                        <div class="form-group">
                            <label for="email">Email đăng ký <span class="required">*</span></label>
                            <div class="input-wrapper">
                                <i class="fas fa-envelope input-icon"></i>
                                <input type="email" id="email" name="Email" class="with-icon"
                                       placeholder="Nhập email tài khoản của bạn" autocomplete="email" />
                            </div>
                            <span class="error-message" id="emailError"></span>
                        </div>

                        <button type="button" class="btn btn-primary" id="btnSendOTP">
                            <i class="fas fa-paper-plane"></i> Gửi mã OTP
                        </button>

                        <div style="text-align: center; margin-top: 15px;">
                            <a href="@Url.Action("Login", "Account")" style="color: #666; text-decoration: none; font-size: 14px;">
                                <i class="fas fa-arrow-left"></i> Quay lại đăng nhập
                            </a>
                        </div>
                    </div>

                    <div class="form-section" id="step2">
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            <div>Mã xác thực đã được gửi đến: <strong id="displayEmail"></strong></div>
                        </div>

                        <div class="form-group">
                            <label>Nhập mã OTP (6 số)</label>
                            <div class="otp-container">
                                <input type="text" class="otp-input" maxlength="1" data-index="0" />
                                <input type="text" class="otp-input" maxlength="1" data-index="1" />
                                <input type="text" class="otp-input" maxlength="1" data-index="2" />
                                <input type="text" class="otp-input" maxlength="1" data-index="3" />
                                <input type="text" class="otp-input" maxlength="1" data-index="4" />
                                <input type="text" class="otp-input" maxlength="1" data-index="5" />
                            </div>
                            <input type="hidden" id="otpCode" name="OtpCode" />
                            <span class="error-message" id="otpError"></span>
                        </div>

                        <div class="otp-timer">
                            Mã OTP hết hạn sau: <strong id="countdown">05:00</strong>
                        </div>

                        <div class="resend-otp">
                            <span>Chưa nhận được mã? </span>
                            <a href="#" class="resend-link disabled" id="btnResend">Gửi lại</a>
                        </div>

                        <div class="btn-group">
                            <button type="button" class="btn btn-secondary" onclick="goToStep(1)">Quay lại</button>
                            <button type="button" class="btn btn-primary" id="btnVerifyOTP">Xác thực</button>
                        </div>
                    </div>

                    <div class="form-section" id="step3">
                        <div class="form-group">
                            <label for="newPassword">Mật khẩu mới <span class="required">*</span></label>
                            <div class="input-wrapper">
                                <i class="fas fa-lock input-icon"></i>
                                <input type="password" id="newPassword" name="NewPassword" class="with-icon"
                                       placeholder="Nhập mật khẩu mới" autocomplete="new-password" />
                            </div>
                            <span class="error-message" id="newPasswordError"></span>
                        </div>

                        <div class="form-group">
                            <label for="confirmPassword">Xác nhận mật khẩu <span class="required">*</span></label>
                            <div class="input-wrapper">
                                <i class="fas fa-lock input-icon"></i>
                                <input type="password" id="confirmPassword" name="ConfirmPassword" class="with-icon"
                                       placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" />
                            </div>
                            <span class="error-message" id="confirmPasswordError"></span>
                        </div>

                        <button type="button" class="btn btn-primary" id="btnResetPassword">
                            Đổi mật khẩu
                        </button>
                    </div>

                    <div class="form-section" id="step4">
                        <div class="alert alert-success" style="flex-direction: column; text-align: center; padding: 30px;">
                            <i class="fas fa-check-circle" style="font-size: 3rem; margin-bottom: 15px;"></i>
                            <h3 style="color: #2e7d32; margin-bottom: 10px;">Thành công!</h3>
                            <p>Mật khẩu của bạn đã được cập nhật.</p>
                            <p style="font-size: 13px; color: #666;">Đang chuyển hướng về trang đăng nhập...</p>
                        </div>
                    </div>

                </form>
            </div>

            <div class="card-footer">
                <p>&copy; @DateTime.Now.Year OnlyPhone. All rights reserved.</p>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // --- LOGIC XỬ LÝ JS ---
        $(document).ready(function () {

            // 1. XỬ LÝ INPUT OTP (Tự động nhảy ô)
            $('.otp-input').on('keyup', function (e) {
                const index = $(this).data('index');
                const val = $(this).val();

                // Chỉ cho nhập số
                if (!/^\d*$/.test(val)) {
                    $(this).val('');
                    return;
                }

                // Tự động focus ô tiếp theo
                if (val.length === 1 && index < 5) {
                    $('.otp-input[data-index="' + (index + 1) + '"]').focus();
                }

                // Backspace để quay lại ô trước
                if (e.key === 'Backspace' && index > 0 && val.length === 0) {
                    $('.otp-input[data-index="' + (index - 1) + '"]').focus();
                }

                // Cập nhật giá trị vào hidden input
                updateHiddenOtp();
            });

            function updateHiddenOtp() {
                let otp = '';
                $('.otp-input').each(function () {
                    otp += $(this).val();
                });
                $('#otpCode').val(otp);
            }

            // 2. LOGIC CHUYỂN BƯỚC (STEP)
            window.goToStep = function(step) {
                // Ẩn tất cả steps
                $('.form-section').removeClass('active');
                // Hiện step yêu cầu
                $('#step' + step).addClass('active');

                // Cập nhật indicator (Thanh tiến trình)
                $('.step').removeClass('active completed');
                for (let i = 1; i <= 3; i++) {
                    if (i < step) {
                        $('#indicator' + i).addClass('completed');
                    } else if (i === step) {
                        $('#indicator' + i).addClass('active');
                    }
                }

                // Clear alerts khi chuyển trang
                $('#alertContainer').html('');
            };

            function showAlert(message, type) {
                const icon = type === 'danger' ? 'fa-exclamation-circle' : 'fa-check-circle';
                const html = `
                    <div class="alert alert-${type}">
                        <i class="fas ${icon}"></i>
                        <span>${message}</span>
                    </div>`;
                $('#alertContainer').html(html);
            }

            // 3. XỬ LÝ AJAX CÁC BƯỚC

            // --- BƯỚC 1: GỬI OTP ---
            $('#btnSendOTP').click(function () {
                const email = $('#email').val();
                if (!email) {
                    $('#emailError').text('Vui lòng nhập email');
                    return;
                } else {
                    $('#emailError').text('');
                }

                const btn = $(this);
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang xử lý...');

                $.ajax({
                    url: '@Url.Action("SendResetOTP", "Account")',
                    type: 'POST',
                    data: {
                        email: email,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (res) {
                        btn.prop('disabled', false).html('<i class="fas fa-paper-plane"></i> Gửi mã OTP');

                        if (res.success) {
                            $('#displayEmail').text(email);
                            goToStep(2);
                            startTimer(300); // 5 phút
                        } else {
                            showAlert(res.message, 'danger');
                        }
                    },
                    error: function () {
                        btn.prop('disabled', false).html('<i class="fas fa-paper-plane"></i> Gửi mã OTP');
                        showAlert('Lỗi kết nối máy chủ', 'danger');
                    }
                });
            });

           // --- BƯỚC 2: XÁC THỰC OTP ---
$('#btnVerifyOTP').click(function () {
    const otp = $('#otpCode').val();

    // Reset trạng thái lỗi cũ
    $('.otp-input').removeClass('input-error');
    $('#otpError').text('');

    if (otp.length < 6) {
        $('#otpError').text('Vui lòng nhập đủ 6 số');
        $('.otp-container').addClass('shake'); // Rung nhẹ cảnh báo
        setTimeout(() => $('.otp-container').removeClass('shake'), 300);
        return;
    }

    const btn = $(this);
    btn.prop('disabled', true).text('Đang kiểm tra...');

    $.ajax({
        url: '@Url.Action("CheckResetOTP", "Account")',
        type: 'POST',
        data: {
            otp: otp,
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        },
        success: function (res) {
            btn.prop('disabled', false).text('Xác thực');
            if (res.success) {
                goToStep(3);
            } else {
                // HIỂN THỊ LỖI KHI SAI OTP
                $('#otpError').text(res.message || 'Mã OTP không đúng');
                $('.otp-input').addClass('input-error'); // Viền đỏ các ô nhập
                $('.otp-input').first().focus(); // Focus lại ô đầu
            }
        },
        error: function () {
            btn.prop('disabled', false).text('Xác thực');
            $('#otpError').text('Lỗi kết nối server');
        }
    });
});
            $('#btnResetPassword').click(function () {
    const p1 = $('#newPassword').val();
    const p2 = $('#confirmPassword').val();

    // Reset lỗi cũ
    $('#newPasswordError, #confirmPasswordError').text('');
    $('#newPassword, #confirmPassword').removeClass('input-error');

    let isValid = true;

    if (p1.length < 6) {
        $('#newPasswordError').text('Mật khẩu tối thiểu 6 ký tự');
        $('#newPassword').addClass('input-error');
        isValid = false;
    }

    // KIỂM TRA MẬT KHẨU XÁC NHẬN
    if (p1 !== p2) {
        $('#confirmPasswordError').text('Mật khẩu xác nhận không khớp');
        $('#confirmPassword').addClass('input-error'); // Viền đỏ ô xác nhận
        isValid = false;
    }

    if (!isValid) return;

    const btn = $(this);
    btn.prop('disabled', true).text('Đang xử lý...');

    $.ajax({
        url: '@Url.Action("ConfirmResetPassword", "Account")',
        type: 'POST',
        data: {
            newPassword: p1,
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        },
        success: function (res) {
            if (res.success) {
                goToStep(4);
                setTimeout(function() {
                    window.location.href = res.redirectUrl || '/Account/Login';
                }, 2000);
            } else {
                btn.prop('disabled', false).text('Đổi mật khẩu');
                // Dùng showAlert để hiện lỗi từ server (nếu có)
                showAlert(res.message, 'danger');
            }
        },
        error: function () {
            btn.prop('disabled', false).text('Đổi mật khẩu');
            showAlert('Lỗi hệ thống', 'danger');
        }
    });
});

            // Timer đếm ngược
            function startTimer(duration) {
                let timer = duration, minutes, seconds;
                const display = $('#countdown');
                const link = $('#btnResend');

                link.addClass('disabled');

                const interval = setInterval(function () {
                    minutes = parseInt(timer / 60, 10);
                    seconds = parseInt(timer % 60, 10);

                    minutes = minutes < 10 ? "0" + minutes : minutes;
                    seconds = seconds < 10 ? "0" + seconds : seconds;

                    display.text(minutes + ":" + seconds);

                    if (--timer < 0) {
                        clearInterval(interval);
                        display.text("00:00");
                        link.removeClass('disabled'); // Cho phép gửi lại
                    }
                }, 1000);
            }

            // Xử lý nút Gửi lại OTP
            $('#btnResend').click(function(e) {
                e.preventDefault();
                if($(this).hasClass('disabled')) return;

                // Gọi lại API gửi OTP (giống bước 1)
                $('#btnSendOTP').click();
            });
        });
    </script>
</body>
</html>