@model OnlyPhone.Areas.Admin.Data.VoucherPageModel
@{
    ViewBag.Title = "Quản lý Voucher";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    /* CSS Cũ giữ nguyên, chỉ sửa phần Thumbnail */
    .stats-container {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 24px;
    }

    .stat-card-flat {
        background: var(--panel);
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: var(--shadow);
        border: 1px solid rgba(0,0,0,0.03);
    }

    .stat-info .stat-label {
        color: var(--muted);
        font-size: 14px;
        margin-bottom: 4px;
        font-weight: 500;
    }

    .stat-info .stat-num {
        color: var(--text);
        font-size: 24px;
        font-weight: 700;
        line-height: 1;
    }

    .stat-icon-box {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .bg-accent-light {
        background: rgba(68, 161, 246, 0.1);
        color: var(--accent);
    }

    .bg-positive-light {
        background: rgba(16, 185, 129, 0.1);
        color: var(--positive);
    }

    .bg-danger-light {
        background: rgba(239, 68, 68, 0.1);
        color: var(--danger);
    }

    .bg-purple-light {
        background: rgba(139, 92, 246, 0.1);
        color: #8b5cf6;
    }

    .action-bar {
        background: var(--panel);
        padding: 16px 20px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        box-shadow: var(--shadow);
        border: 1px solid rgba(0,0,0,0.03);
        flex-wrap: wrap;
        gap: 15px;
    }

    .action-left {
        display: flex;
        align-items: center;
        gap: 15px;
        flex: 1;
        min-width: 300px;
    }

    .page-title {
        font-weight: 700;
        font-size: 16px;
        color: var(--text);
        white-space: nowrap;
        margin-right: 10px;
    }

    .search-group {
        position: relative;
        flex: 1;
        max-width: 400px;
    }

    .search-input {
        background: var(--bg);
        border: 1px solid rgba(0,0,0,0.05);
        padding: 10px 15px;
        padding-left: 38px;
        border-radius: 8px;
        width: 100%;
        font-size: 14px;
        color: var(--text);
        transition: 0.2s;
    }

        .search-input:focus {
            outline: none;
            border-color: var(--accent);
            background: var(--panel);
        }

    .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--muted);
        font-size: 14px;
    }

    .voucher-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .voucher-row {
        background: var(--panel);
        border-radius: 12px;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: var(--shadow);
        border: 1px solid rgba(0,0,0,0.03);
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .voucher-row:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        }

    .v-col-info {
        display: flex;
        align-items: center;
        gap: 16px;
        flex: 2;
        min-width: 250px;
    }

    /* SỬA PHẦN THUMBNAIL: Đơn giản hóa, bỏ style "Tiền" */
    .v-thumb {
        width: 48px;
        height: 56px;
        border-radius: 8px;
        background: var(--bg); /* Màu nền mặc định */
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: var(--muted);
        font-size: 20px; /* Icon to hơn */
        flex-shrink: 0;
        border: 1px solid rgba(0,0,0,0.05);
    }
        /* Chỉ giữ lại style đặc biệt cho Percent nếu muốn, hoặc để mặc định */
        .v-thumb.is-percent {
            color: var(--accent);
            background: rgba(68, 161, 246, 0.08);
        }

    .v-details h6 {
        margin: 0;
        font-size: 15px;
        font-weight: 700;
        color: var(--text);
    }

    .v-sub {
        font-size: 13px;
        color: var(--muted);
        margin-top: 4px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .v-col-price {
        text-align: right;
        flex: 1;
        font-weight: 700;
        color: var(--accent);
        font-size: 15px;
        min-width: 100px;
    }

    .v-col-stock {
        text-align: right;
        flex: 1;
        font-size: 13px;
        color: var(--muted);
        min-width: 120px;
    }

        .v-col-stock span {
            display: block;
        }

    .stock-val {
        color: var(--text);
        font-weight: 600;
    }

    .v-col-status {
        flex: 0.8;
        text-align: right;
        display: flex;
        justify-content: flex-end;
        min-width: 120px;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .st-active {
        background: rgba(16, 185, 129, 0.1);
        color: var(--positive);
    }

    .st-warning {
        background: rgba(245, 158, 11, 0.1);
        color: #f59e0b;
    }

    .st-expired {
        background: rgba(239, 68, 68, 0.1);
        color: var(--danger);
    }

    .st-private {
        background: rgba(139, 92, 246, 0.1);
        color: #8b5cf6;
    }

    .v-col-action {
        flex: 0.5;
        display: flex;
        gap: 8px;
        justify-content: flex-end;
        min-width: 100px;
    }

    .btn-icon-gray {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: var(--bg);
        border: none;
        color: var(--muted);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn-icon-gray:hover {
            background: rgba(0,0,0,0.05);
            color: var(--text);
        }

    /* Modal Fix */
    .modal-content {
        background: var(--panel);
        color: var(--text);
        border-radius: 16px;
    }

    .form-control, .form-select {
        background: var(--bg);
        color: var(--text);
        border: 1px solid rgba(0,0,0,0.1);
    }
</style>

<div class="stats-container">
    <div class="stat-card-flat">
        <div class="stat-info">
            <div class="stat-label">Tổng Voucher</div>
            <div class="stat-num">@Model.Stats.Total</div>
        </div>
        <div class="stat-icon-box bg-accent-light"><i class="fa fa-ticket-alt"></i></div>
    </div>

    <div class="stat-card-flat">
        <div class="stat-info">
            <div class="stat-label">Đang chạy</div>
            <div class="stat-num" style="color:var(--positive)">@Model.Stats.Active</div>
        </div>
        <div class="stat-icon-box bg-positive-light"><i class="fa fa-play"></i></div>
    </div>

    <div class="stat-card-flat">
        <div class="stat-info">
            <div class="stat-label">Riêng tư</div>
            <div class="stat-num" style="color:#8b5cf6">@Model.Stats.Private</div>
        </div>
        <div class="stat-icon-box bg-purple-light"><i class="fa fa-lock"></i></div>
    </div>

    <div class="stat-card-flat">
        <div class="stat-info">
            <div class="stat-label">Hết hạn</div>
            <div class="stat-num" style="color:var(--danger)">@Model.Stats.Expired</div>
        </div>
        <div class="stat-icon-box bg-danger-light"><i class="fa fa-clock"></i></div>
    </div>
</div>

<div class="action-bar">
    <div class="action-left">
        <div class="page-title">Danh sách voucher</div>
        <select class="form-select" style="width: 160px; background: var(--bg); border:none;"
                onchange="window.location.href='?status='+this.value+'&keyword=@Model.Keyword'">
            <option value="">Tất cả trạng thái</option>
            <option value="1" @(Model.StatusFilter == 1 ? "selected" : "")>Đang chạy</option>
            <option value="2" @(Model.StatusFilter == 2 ? "selected" : "")>Hết hạn</option>
            <option value="3" @(Model.StatusFilter == 3 ? "selected" : "")>Riêng tư</option>
        </select>
        <form class="search-group" method="get">
            <input type="hidden" name="status" value="@Model.StatusFilter" />
            <i class="fa fa-search search-icon"></i>
            <input type="text" name="keyword" class="search-input" placeholder="Tìm tên, mã voucher..." value="@Model.Keyword">
        </form>
    </div>

    <button class="btn btn-primary" onclick="openModal()"
            style="background: var(--accent); border: none; border-radius: 8px; padding: 10px 20px; font-weight: 600; box-shadow: 0 4px 10px rgba(68, 161, 246, 0.3);">
        <i class="fa fa-plus me-2"></i> Thêm mới
    </button>
</div>

<div class="voucher-list">
    @if (Model.List == null || Model.List.Count == 0)
    {
        <div class="text-center py-5 muted-sm">
            <i class="fa fa-box-open fa-3x mb-3" style="opacity:0.3"></i><br />Không tìm thấy voucher nào.
        </div>
    }
    else
    {
        foreach (var item in Model.List)
        {
            // Logic Badge
            string badgeClass = "st-active";
            string badgeText = "Đang chạy";
            if (item.StatusLabel == "Hết hạn") { badgeClass = "st-expired"; badgeText = "Hết hạn"; }
            else if (!item.IsPublic) { badgeClass = "st-private"; badgeText = "Riêng tư"; }
            else if (!item.IsActive) { badgeClass = "st-warning"; badgeText = "Tạm dừng"; }

            // Logic Thumb (Đã sửa: Bỏ style "Tiền")
            string thumbClass = item.IsPercent ? "is-percent" : "";
            // Nếu là % thì hiện icon %, còn lại hiện icon tag
            string iconClass = item.IsPercent ? "fa-percentage" : "fa-ticket-alt";

            <div class="voucher-row">
                <div class="v-col-info">
                    <div class="v-thumb @thumbClass">
                        <i class="fa @iconClass"></i>
                    </div>
                    <div class="v-details">
                        <h6>@item.Code</h6>
                        <div class="v-sub">
                            <span title="Mô tả">@item.Description</span>
                            @if (!item.IsPublic)
                            {<i class="fa fa-lock ms-1" style="font-size:10px" title="Riêng tư"></i>}
                        </div>
                    </div>
                </div>

                <div class="v-col-price">
                    @(item.IsPercent ? item.DiscountValue.ToString("0") + "%" : item.DiscountValue.ToString("N0") + "đ")
                </div>

                <div class="v-col-stock">
                    <span>Kho: <span class="stock-val">@item.Quantity</span></span>
                    <span>Đã dùng: <span class="stock-val">@item.QuantityUsed</span></span>
                </div>

                <div class="v-col-status">
                    <span class="status-badge @badgeClass">@badgeText</span>
                </div>

                <div class="v-col-action">
                    <button class="btn-icon-gray" onclick="editVoucher(@item.VoucherID)" title="Sửa">
                        <i class="fa fa-pen" style="font-size: 13px;"></i>
                    </button>

                    <div class="dropdown">
                        <button class="btn-icon-gray" data-bs-toggle="dropdown">
                            <i class="fa fa-ellipsis-v" style="font-size: 13px;"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="border-radius:10px; padding: 8px;">
                            <li><a class="dropdown-item rounded" href="javascript:void(0)" onclick="viewDetail(@item.VoucherID)"><i class="fa fa-eye me-2 text-primary"></i> Xem chi tiết</a></li>
                            @if (!item.IsPublic)
                            {
                                <li><a class="dropdown-item rounded" href="javascript:void(0)" onclick="viewDetail(@item.VoucherID)"><i class="fa fa-gift me-2" style="color:#8b5cf6"></i> Tặng khách</a></li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item rounded text-danger" href="javascript:void(0)" onclick="deleteVoucher(@item.VoucherID)"><i class="fa fa-trash me-2"></i> Xóa</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        }
    }
</div>

@if (Model.TotalPages > 1)
{
    <div class="d-flex justify-content-center mt-4">
        <nav>
            <ul class="pagination">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="?page=@(Model.CurrentPage - 1)&keyword=@Model.Keyword&status=@Model.StatusFilter"><i class="fa fa-chevron-left"></i></a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="?page=@i&keyword=@Model.Keyword&status=@Model.StatusFilter">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?page=@(Model.CurrentPage + 1)&keyword=@Model.Keyword&status=@Model.StatusFilter"><i class="fa fa-chevron-right"></i></a>
                </li>
            </ul>
        </nav>
    </div>
}

<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-weight-bold">Chi tiết Voucher</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-4">
                    <h3 id="d-code" class="fw-bold" style="color:var(--accent); letter-spacing: 2px;">CODE</h3>
                    <span id="d-type-badge" class="badge bg-light text-dark">Loại</span>
                </div>
                <div class="row mb-2"><div class="col-6 text-muted">Giảm giá</div><div class="col-6 text-end fw-bold" id="d-discount"></div></div>
                <div class="row mb-2"><div class="col-6 text-muted">Đơn tối thiểu</div><div class="col-6 text-end" id="d-min"></div></div>
                <div class="row mb-2"><div class="col-6 text-muted">Giảm tối đa</div><div class="col-6 text-end" id="d-max"></div></div>
                <div class="row mb-2"><div class="col-6 text-muted">Hạn sử dụng</div><div class="col-6 text-end" id="d-date"></div></div>
                <div class="row mb-2"><div class="col-6 text-muted">Giới hạn/User</div><div class="col-6 text-end" id="d-usage"></div></div>

                <div id="gift-section" class="mt-4 p-3 rounded" style="background: var(--bg); display:none; border:1px dashed #8b5cf6">
                    <h6 class="fw-bold mb-2" style="color:#8b5cf6"><i class="fa fa-gift me-2"></i>Tặng Mã Này</h6>
                    <div class="input-group">
                        <input type="hidden" id="gift-vid" />
                        <input type="text" id="gift-user" class="form-control" placeholder="Nhập Email hoặc ID User...">
                        <button class="btn btn-primary" style="background:#8b5cf6; border:none" onclick="submitGift()">Tặng</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="formModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-weight-bold" id="modalTitle">Tạo Voucher</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="voucherForm">
                    <input type="hidden" name="VoucherID" id="f-id" value="0">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Mã Code (Bắt buộc)</label>
                            <input type="text" name="Code" id="f-code" class="form-control fw-bold" required placeholder="VD: SALE50">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Tên/Mô tả</label>
                            <input type="text" name="Description" id="f-desc" class="form-control" placeholder="VD: Giảm giá ngày hè">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label text-muted small">Loại giảm</label>
                            <select name="IsPercent" id="f-ispercent" class="form-select">
                                <option value="false">Tiền mặt (VND)</option>
                                <option value="true">Phần trăm (%)</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label text-muted small">Giá trị giảm</label>
                            <input type="number" name="DiscountValue" id="f-val" class="form-control" required>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label text-muted small">Giảm tối đa (nếu %)</label>
                            <input type="number" name="MaxDiscountAmount" id="f-max" class="form-control">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label text-muted small">Số lượng</label>
                            <input type="number" name="Quantity" id="f-qty" class="form-control" required>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label text-muted small">Lượt dùng/User</label>
                            <input type="number" name="MaxUsagePerUser" id="f-usage" class="form-control" value="1">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label text-muted small">Đơn tối thiểu</label>
                            <input type="number" name="MinOrderValue" id="f-min" class="form-control" value="0">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Ngày bắt đầu</label>
                            <input type="datetime-local" name="StartDate" id="f-start" class="form-control" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Ngày kết thúc</label>
                            <input type="datetime-local" name="EndDate" id="f-end" class="form-control">
                        </div>
                    </div>
                    <div class="p-3 rounded mb-3" style="background: var(--bg)">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="IsPublic" id="f-public" value="true" checked>
                                    <label class="form-check-label" for="f-public">Công khai</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="IsActive" id="f-active" value="true" checked>
                                    <label class="form-check-label" for="f-active">Kích hoạt ngay</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="submitForm()" style="background:var(--accent); border:none">Lưu Voucher</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/Bootstrap/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/Bootstrap/jquery-3.7.0.min.js"></script>
    <script>
        // --- CẤU HÌNH CHO BOOTSTRAP 5 ---

        // Hàm an toàn để mở Modal trong Bootstrap 5
        function showModal(modalId) {
            var myModalEl = document.getElementById(modalId);
            // getOrCreateInstance giúp tránh lỗi khi mở lại modal nhiều lần
            var modal = bootstrap.Modal.getOrCreateInstance(myModalEl);
            modal.show();
        }

        // Hàm xử lý ngày tháng (ISO String)
        function parseJsonDate(jsonDateString) {
            if (!jsonDateString) return null;
            if (typeof jsonDateString === 'string' && jsonDateString.indexOf('/Date') !== -1) {
                return new Date(parseInt(jsonDateString.substr(6)));
            }
            return new Date(jsonDateString);
        }

        // Format tiền tệ
        function formatMoney(n) {
            return n ? n.toFixed(0).replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1,') + ' đ' : '0 đ';
        }

        // ================= CHỨC NĂNG CHÍNH =================

        // 1. Xem Chi tiết
        function viewDetail(id) {
            $.get('/Admin/Voucher/GetDetail/' + id, function (data) {
                $('#d-code').text(data.Code);
                $('#d-discount').text(data.IsPercent ? data.DiscountValue + "%" : formatMoney(data.DiscountValue));
                $('#d-min').text(formatMoney(data.MinOrderValue));
                $('#d-max').text(data.MaxDiscountAmount ? formatMoney(data.MaxDiscountAmount) : "Không giới hạn");
                $('#d-usage').text(data.MaxUsagePerUser + " lần");

                if (data.IsPublic) {
                    $('#d-type-badge').text("Công khai").removeClass('bg-warning').addClass('bg-success text-white');
                } else {
                    $('#d-type-badge').text("Riêng tư").removeClass('bg-success').addClass('bg-warning text-dark');
                }

                var start = parseJsonDate(data.StartDate);
                var dateStr = start ? start.toLocaleDateString('vi-VN') : "";

                if (data.EndDate) {
                    var end = parseJsonDate(data.EndDate);
                    dateStr += " - " + end.toLocaleDateString('vi-VN');
                } else {
                    dateStr += " - Vô thời hạn";
                }
                $('#d-date').text(dateStr);

                if (!data.IsPublic) {
                    $('#gift-section').show();
                    $('#gift-vid').val(data.VoucherID);
                } else {
                    $('#gift-section').hide();
                }

                // SỬA LỖI Ở ĐÂY: Dùng hàm showModal chuẩn BS5
                showModal('detailModal');

            }).fail(function () {
                alert("Lỗi tải dữ liệu. Vui lòng kiểm tra console.");
            });
        }

        // 2. Submit Tặng Voucher
        function submitGift() {
            var vid = $('#gift-vid').val();
            var user = $('#gift-user').val();
            if (!user) { alert("Vui lòng nhập Email hoặc ID User"); return; }

            var btn = event.target;
            var oldText = btn.innerText;
            btn.innerText = "Đang gửi...";
            btn.disabled = true;

            $.post('/Admin/Voucher/Gift', { voucherId: vid, userIdent: user }, function (res) {
                alert(res.message);
                if (res.success) $('#gift-user').val('');
                btn.innerText = oldText; btn.disabled = false;
            }).fail(function () {
                alert("Lỗi kết nối server");
                btn.innerText = oldText; btn.disabled = false;
            });
        }

        // 3. Mở Modal Create
        function openModal() {
            $('#voucherForm')[0].reset();
            $('#f-id').val(0);
            $('#modalTitle').text("Tạo Voucher Mới");

            var now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            $('#f-start').val(now.toISOString().slice(0, 16));

            // SỬA LỖI Ở ĐÂY
            showModal('formModal');
        }

        // 4. Mở Modal Edit
        function editVoucher(id) {
            $.get('/Admin/Voucher/GetDetail/' + id, function (data) {
                $('#f-id').val(data.VoucherID);
                $('#f-code').val(data.Code);
                $('#f-desc').val(data.Description);
                $('#f-val').val(data.DiscountValue);
                $('#f-qty').val(data.Quantity);
                $('#f-min').val(data.MinOrderValue);
                $('#f-max').val(data.MaxDiscountAmount);
                $('#f-usage').val(data.MaxUsagePerUser);

                $('#f-ispercent').val(data.IsPercent ? "true" : "false");
                $('#f-public').prop('checked', data.IsPublic);
                $('#f-active').prop('checked', data.IsActive);

                var start = parseJsonDate(data.StartDate);
                if (start) {
                    start.setMinutes(start.getMinutes() - start.getTimezoneOffset());
                    $('#f-start').val(start.toISOString().slice(0, 16));
                }

                if (data.EndDate) {
                    var end = parseJsonDate(data.EndDate);
                    end.setMinutes(end.getMinutes() - end.getTimezoneOffset());
                    $('#f-end').val(end.toISOString().slice(0, 16));
                }

                $('#modalTitle').text("Cập nhật Voucher");

                // SỬA LỖI Ở ĐÂY
                showModal('formModal');
            });
        }

        // 5. Submit Form
        function submitForm() {
            var formData = $('#voucherForm').serialize();
            if (!$('#f-public').is(':checked')) formData += "&IsPublic=false";
            if (!$('#f-active').is(':checked')) formData += "&IsActive=false";

            $.post('/Admin/Voucher/Save', formData, function (res) {
                if (res.success) {
                    location.reload();
                } else {
                    alert(res.message);
                }
            });
        }

        // 6. Xóa Voucher
        function deleteVoucher(id) {
            if (confirm("Bạn có chắc muốn xóa voucher này?")) {
                $.post('/Admin/Voucher/Delete', { id: id }, function (res) {
                    if (res.success) location.reload();
                    else alert(res.message);
                });
            }
        }
    </script>
}